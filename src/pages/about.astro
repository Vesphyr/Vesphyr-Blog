---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="关于" description="关于本站和作者">
	<script>
		import("../scripts/right-sidebar-layout.ts");
	</script>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">

			
			<section class="about-section">
				<h3 class="about-section-title">关于本站</h3>
				<div class="about-content">
					<p>本站以宋锦为底色——背景铺陈回纹提花与龟背纹，如古帛徐徐展开，随四季明暗流转。</p>
					<p>三种主题色随心切换：<strong>御朱红</strong>（丹砂之正）、<strong>群青蓝</strong>（青金之贵）、<strong>皇家紫</strong>（骨螺之尊），各有一番气象。</p>
					<p>内置音乐播放器，收藏三十余首中式古典雅乐，可于页面右下角随时聆听；相册收录旅途光影，与文章一同织成这方锦绣。</p>
				</div>
			</section>

			
			<section class="about-section">
				<h3 class="about-section-title">头像角色</h3>
				<div class="about-content">
					<p>站点头像是<strong>成田真理</strong>（なりた しんり）。</p>
					<p>他出自晓WORKS制作的游戏《淑女同萌！》及其衍生作品，是统筹学园的"皇冠"第六人——意志坚定、实力强大的主人公。</p>
				</div>
			</section>

			
			<section class="about-section">
				<h3 class="about-section-title">联系方式</h3>
				<div class="about-links">
					<a href="https://github.com/Vesphyr" target="_blank" rel="noopener noreferrer" class="about-link">
						<svg viewBox="0 0 24 24" fill="currentColor" class="about-link-icon">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
						<span>GitHub</span>
					</a>
				</div>
			</section>
		</div>
	</div>
</MainGridLayout>

<style>
	.about-section {
		margin-bottom: 2rem;
		padding-bottom: 2rem;
	}

	.about-section:last-child {
		margin-bottom: 0;
		padding-bottom: 0;
	}

	.about-section-title {
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--text-primary);
		margin-bottom: 1rem;
	}

	@media (min-width: 768px) {
		.about-section-title {
			font-size: 2.1rem;
		}
	}

	.about-content {
		font-family: var(--font-content);
		font-size: 1rem;
		color: var(--text-secondary);
		line-height: 1.92;
		letter-spacing: 0.005em;
	}

	@media (min-width: 768px) {
		.about-content {
			font-size: 1.1rem;
			line-height: 1.98;
		}
	}

	.about-content p {
		margin-bottom: 0.75rem;
	}

	.about-content p:last-child {
		margin-bottom: 0;
	}

	.about-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.about-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.25rem;
		background: var(--btn-regular-bg);
		border-radius: 0.5rem;
		color: var(--text-primary);
		text-decoration: none;
		font-size: 0.9375rem;
		transition: all 0.2s ease;
	}

	.about-link:hover {
		background: var(--btn-regular-bg-hover);
		transform: translateY(-2px);
	}

	.about-link-icon {
		width: 1.25rem;
		height: 1.25rem;
		flex-shrink: 0;
	}
</style>