---
import ConfigCarrier from "@components/ConfigCarrier.astro";
import BackToTop from "@components/control/BackToTop.astro";
import JsonLd from "@components/seo/JsonLd.astro";
import MusicPlayer from "@components/widget/MusicPlayer.svelte";
import { ClientRouter } from "astro:transitions";
import { musicPlayerConfig, profileConfig, siteConfig } from "@/config";
import { PAGE_WIDTH, } from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
// Font @font-face declarations are served as a static, non-render-blocking async
// stylesheet from /fonts/font-faces.css (generated by scripts/copy-font-css.js from
// the generated-zhuque-* sources). This keeps them entirely out of the bundled core
// CSS (MainGridLayout/main) and avoids Vite re-emitting the aggregator chunk. Fonts
// use font-display: swap, so text renders with a fallback immediately and swaps to
// Zhuque once the async CSS + woff2 arrive — no layout shift, no blocking.
interface Props {
    title?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    postSlug?: string;
    canonicalUrl?: string;
}
let { title, description, lang, setOGTypeArticle, postSlug } = Astro.props;
const canonicalUrl = Astro.props.canonicalUrl || Astro.url.toString();
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const configHue = siteConfig.themeColor.hue;
let pageTitle: string;
if (title) {
    pageTitle = `${title} - ${siteConfig.title}`;
}
else {
    pageTitle = siteConfig.subtitle
        ? `${siteConfig.title} - ${siteConfig.subtitle}`
        : siteConfig.title;
}
const pageDescription = description ?? siteConfig.subtitle;
let ogImageUrl: string | undefined;
if (siteConfig.generateOgImages) {
    if (postSlug) {
        ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
    } else if (isHomePage) {
        ogImageUrl = new URL(`/og/home.png`, Astro.site).toString();
    }
}
const favicons: Favicon[] = siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
if (!lang) {
    lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");
const isChineseSite = siteLang.toLowerCase().startsWith("zh");
const skipToContentLabel = isChineseSite
    ? "\u8df3\u8f6c\u5230\u6b63\u6587"
    : "Skip to content";
---

<!doctype html>
<html lang={siteLang} class="bg-(--page-bg)">
  <head>
    <title>{pageTitle}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://api.iconify.design" crossorigin />
    {/* 拉丁字母/数字字体：正文字重 450 按 CSS 字重匹配规则会落到 500（Medium），
        因此预加载 Medium 而不是 Regular，避免首屏先下 Regular 再补 Medium。 */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
      href="/assets/fonts/CrimsonPro-Medium.woff2"
    />
    {/* 中文首屏字体：约 2000 常用字（403KB），字形与分片一致，预加载后中文
        立刻从系统兜底字体切换，不必等待 /fonts/font-faces.css 解析 + 分片下载。 */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
      href="/assets/fonts/ZhuqueFangsong-Regular-UI.woff2"
    />
    {/* 186 条 @font-face 以非阻塞方式挂载：media=print 让浏览器低优先级下载，
        加载完成后立刻切回 all。不用 load 事件改 rel，因为命中缓存时 load 可能
        早于内联脚本执行，导致样式表永远挂不上、全站中文退化到兜底字体。 */}
    <link
      rel="stylesheet"
      media="print"
      onload="this.onload=null;this.media='all'"
      href="/fonts/font-faces.css"
    />
    <noscript><link rel="stylesheet" href="/fonts/font-faces.css" /></noscript>
    <link rel="canonical" href={canonicalUrl} />
    <ClientRouter />
    <meta name="description" content={pageDescription} />
    <meta name="google" content="notranslate" />
    <meta name="googlebot" content="notranslate" />

    {
      siteConfig.keywords && siteConfig.keywords.length > 0 && (
        <meta name="keywords" content={siteConfig.keywords.join(", ")} />
      )
    }
    <meta name="author" content={profileConfig.name} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={pageTitle} />}
    {
      setOGTypeArticle ? (
        <meta property="og:type" content="article" />
      ) : (
        <meta property="og:type" content="website" />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={pageTitle} />}
    {
      favicons.map((favicon) => (
        <link
          rel="icon"
          href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src}
          sizes={favicon.sizes}
          media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
        />
      ))
    }

    
    <script
      is:inline
      define:vars={{
        PAGE_WIDTH,
        configHue,
      }}
    >
      let storedHue = null;
      try { storedHue = localStorage.getItem("hue"); } catch (_e) {}
      const hue = storedHue || configHue;
      document.documentElement.style.setProperty("--hue", hue);
      (function () {
          function updateViewportHeightVar() {
              document.documentElement.style.setProperty("--vh", `${window.innerHeight * 0.01}px`);
          }
          updateViewportHeightVar();
          window.__cncUpdateViewportHeight = updateViewportHeightVar;
      })();
    </script>
    <style
      define:vars={{
        configHue,
        "page-width": `${PAGE_WIDTH}rem`,
      }}
    ></style>
    
    <script>
      document.addEventListener("astro:page-load", () => {
        const root = document.documentElement;
        const carrier = document.getElementById("config-carrier");
        const defaultHue = carrier?.dataset.hue ?? (root.style.getPropertyValue("--hue") || "325");
        let storedHue: string | null = null;
        try { storedHue = localStorage.getItem("hue"); } catch (_e) {}
        const hue = storedHue ?? defaultHue;
        root.style.setProperty("--hue", hue);
      });
    </script>

    <slot name="head" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={profileConfig.name}
      href={`${Astro.site}rss.xml`}
    />

    
    <JsonLd type={setOGTypeArticle ? "article" : "website"} />
  </head>
  <body
    class:list={[
      "min-h-screen",
      {
        "is-home-page": isHomePage,
      },
    ]}
  >
    <a href="#main-content" class="skip-to-content">{skipToContentLabel}</a>
    <script>
      import "../scripts/page-lifecycle.ts";
    </script>
    
    <ConfigCarrier />
    <slot />
    <BackToTop />

    
    {musicPlayerConfig.enable && <MusicPlayer client:idle transition:persist />}

    
    <div id="page-height-extend" class="hidden h-[300vh]"></div>
  </body>
</html>

<style
  is:global
  define:vars={{
    hue: configHue,
  }}
>
  @import "../styles/main.css";

  :root {
    --hue: var(--hue, ${configHue});
  }

  
  .goog-te-banner-frame,
  .goog-te-menu-frame,
  .goog-te-balloon-frame,
  #goog-gt-tt,
  .goog-tooltip,
  .goog-text-highlight {
    display: none !important;
  }

  body {
    top: 0 !important;
  }

  .skip-to-content {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 70;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--primary) 20%, transparent);
    background: color-mix(in oklch, var(--card-bg) 92%, white);
    color: var(--text-main);
    box-shadow: var(--shadow-md);
    transform: translateY(-180%);
    transition: transform 180ms ease;
  }

  .skip-to-content:focus {
    transform: translateY(0);
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  @layer components {
    .navbar-hidden {
      @apply opacity-0 -translate-y-16;
    }
  }
</style>

<script>
  import "../scripts/layout-runtime.ts";
</script>

<script is:inline>
  (function () {
      if (window.__cncOrientationBound) return;
      window.__cncOrientationBound = true;
      const updateViewportHeight = window.__cncUpdateViewportHeight;
      if (typeof updateViewportHeight === "function") {
          window.addEventListener("orientationchange", updateViewportHeight);
      }
  })();
</script>


<script>
  import "../scripts/deferred-page-scripts.ts";
</script>
