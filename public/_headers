# Homepage HTML - short edge cache
/
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=3600

# All non-personalized HTML pages - edge cache (matches homepage policy)
# Keeps content fresh (s-maxage 5min) while serving stale during revalidation.
/about/
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=3600
/albums/
/albums/*
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=3600
/archive/
/archive/*
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=3600
/posts/
/posts/*
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=3600

# RSS/Atom CORS headers
/atom.xml
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Access-Control-Max-Age: 86400

/rss.xml
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Access-Control-Max-Age: 86400

# Static assets - immutable long-term cache (Astro hashes filenames)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Build-generated assets (post-build script output) - hashed filenames
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

# Astro 图片优化产物直接落在 /assets/ 下（文件名带内容 hash，如
# avatar.CESddvee_ZTPKI8.webp），与 css/js 一样可永久缓存；不覆盖的话
# 只会拿到 Pages 默认的 4 小时缓存。
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/*.avif
  Cache-Control: public, max-age=31536000, immutable
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Font files (legacy path) - long-term cache
/assets/font/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Image assets - long-term cache (30 days)
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable
/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable
/assets/posts/*
  Cache-Control: public, max-age=31536000, immutable

# Public image and font assets - immutable long-term cache
/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# font-faces.css 是构建产物但 URL 不带 hash。若沿用上面的 immutable，老访客一年内
# 都拿不到新的 @font-face 规则（字体子集/字符范围更新后会永久失效）。这里覆盖为
# 5 分钟浏览器缓存 + 边缘短暂缓存，兼顾命中率与可更新性。
/fonts/font-faces.css
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# JS files in public - medium cache
/js/*
  Cache-Control: public, max-age=86400

# CSS files in public - medium cache
/assets/css/*
  Cache-Control: public, max-age=86400

# Favicon - long-term cache
/favicon/*
  Cache-Control: public, max-age=31536000, immutable

# Generated OG images (satori + sharp, static output) - short cache so title
# changes become visible promptly (the URL is not content-hashed)
/og/*
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400

# 404 error page - explicit short cache (error responses must not be edge-cached long-term)
/404
  Cache-Control: public, max-age=60

# HTML pages - security headers
# 注意：script-src 的 'unsafe-inline' 只是本地预览的回退值；构建末期
# scripts/csp-script-hashes.mjs 会把它替换为 dist 全部内联脚本/事件处理器的
# SHA-256 白名单（含 script-src-attr），线上策略不含 'unsafe-inline'。
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https://*.music.126.net; font-src 'self' data:; connect-src 'self' https://api.github.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
